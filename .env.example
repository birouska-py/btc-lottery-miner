# Configuração de exemplo — copie para .env e ajuste.
# Todas as variáveis usam o prefixo LOTTERY_.

# Diretório do banco persistente (montado como volume).
LOTTERY_DATA_DIR=/app/data

# Bind do servidor web.
LOTTERY_HOST=0.0.0.0
LOTTERY_PORT=8080

# Pool de mineração padrão (CKPool solo).
LOTTERY_DEFAULT_POOL_URL=stratum+tcp://solo.ckpool.org:3333
LOTTERY_CKPOOL_BASE_URL=https://solo.ckpool.org

# Mineração.
LOTTERY_DEFAULT_THREADS=1
LOTTERY_MAX_THREADS=256

# Observabilidade / rede.
LOTTERY_LOG_BUFFER_SIZE=500
LOTTERY_POOL_STATS_TTL_SECONDS=30
LOTTERY_REQUEST_TIMEOUT_SECONDS=10

# Caminho do binário do minerador (padrão: encontrado no PATH).
# LOTTERY_CPUMINER_BIN=/usr/local/bin/cpuminer
